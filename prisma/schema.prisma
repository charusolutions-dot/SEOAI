generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  queued
  running
  completed
  failed
}

enum IssueSeverity {
  error
  warning
  info
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  projects     Project[]

  @@map("users")
}

model Project {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  url           String
  normalizedUrl String   @map("normalized_url")
  isActive      Boolean  @default(true) @map("is_active")
  lastScanAt    DateTime? @map("last_scan_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id])
  scans Scan[]

  @@index([userId])
  @@map("projects")
}

model Scan {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  status      ScanStatus
  siteScore   Int?        @map("site_score")
  totalPages  Int?        @map("total_pages")
  errorCount  Int?        @map("error_count")
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  issues  Issue[]

  @@index([projectId])
  @@map("scans")
}

model Issue {
  id           String         @id @default(uuid()) @db.Uuid
  scanId       String         @map("scan_id") @db.Uuid
  affectedUrl  String         @map("affected_url")
  ruleCode     String         @map("rule_code")
  severity     IssueSeverity
  category     String
  title        String
  description  String
  fixHint      String         @map("fix_hint")
  impactScore  Int            @map("impact_score")
  aiExplanation String?       @map("ai_explanation")
  createdAt    DateTime       @default(now()) @map("created_at")

  scan Scan @relation(fields: [scanId], references: [id])

  @@index([scanId])
  @@map("issues")
}
